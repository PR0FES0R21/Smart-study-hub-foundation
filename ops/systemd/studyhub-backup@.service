[Unit]
Description=StudyHub encrypted PostgreSQL backup operation (%i)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/studyhub
EnvironmentFile=/etc/studyhub/operations.env
ExecStart=/usr/bin/env docker compose --env-file /etc/studyhub/app.env -f compose.yaml -f compose.backup.yaml run --rm backup %i
TimeoutStartSec=7200
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
