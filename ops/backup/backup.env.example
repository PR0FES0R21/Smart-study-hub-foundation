RESTIC_REPOSITORY_FILE=/run/secrets/restic_repository
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
RESTIC_CACHE_DIR=/backup/state/cache
STUDYHUB_BACKUP_STATE_DIR=/backup/state
STUDYHUB_BACKUP_DATABASE_URL_FILE=/run/secrets/backup_database_url
STUDYHUB_BACKUP_TAG=studyhub-production
STUDYHUB_BACKUP_HOST=studyhub-vps-1
# Set the source snapshot's state path when restoring on a different host/path.
# STUDYHUB_RESTORE_SOURCE_STATE_DIR=/backup/state
# Optional for S3-compatible remote storage; provide private environment values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional RO upload mount in a local override + matching path here.
# STUDYHUB_BACKUP_UPLOADS_DIR=/data/uploads
# Optional: mount the HTTPS webhook URL file as well.
# STUDYHUB_OPS_WEBHOOK_URL_FILE=/run/secrets/ops_webhook
