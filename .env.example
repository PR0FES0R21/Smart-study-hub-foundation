# Prefer: python scripts/init_env.py (generates local-only credentials).
POSTGRES_PASSWORD=replace-with-random-value
APP_DATABASE_PASSWORD=replace-with-another-random-value
CACHE_PASSWORD=replace-with-random-value
CONTROL_PASSWORD=replace-with-random-value
BROKER_PASSWORD=replace-with-random-value
STUDYHUB_DATABASE_URL=postgresql+asyncpg://studyhub_app:replace-with-another-random-value@localhost:55432/studyhub
STUDYHUB_MIGRATION_DATABASE_URL=postgresql+asyncpg://studyhub:replace-with-random-value@localhost:55432/studyhub
STUDYHUB_CACHE_URL=redis://:replace-with-random-value@localhost:56379/0
STUDYHUB_CONTROL_URL=redis://:replace-with-random-value@localhost:56380/0
STUDYHUB_BROKER_URL=redis://:replace-with-random-value@localhost:56381/0
STUDYHUB_JWT_SECRET=generate-at-least-32-random-characters-before-running
STUDYHUB_NAMESPACE=studyhub:dev
STUDYHUB_ENVIRONMENT=development
STUDYHUB_ALLOWED_ORIGINS=["http://localhost:3000"]
STUDYHUB_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
